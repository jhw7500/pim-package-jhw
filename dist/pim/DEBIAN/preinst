#!/bin/bash

############################################################
# preinst script main
############################################################

case "$1" in
install)
  echo "preinst install"
  killall apt apt-get
  rm /var/lib/apt/lists/lock
  rm /var/cache/apt/archives/lock
  rm /var/lib/dpkg/lock*
  dpkg --configure -a
  dpkg --purge pim
  dpkg --purge pim-test
#  systemctl stop rsyslog
#  git config --global user.name "hwjo" && git config --global user.email "hwjo@cantops.biz"
#  /root/SOMBASE_TEST/mfg60n-aarch64-9.32.0.6.sh install
#  lmu -reg FCC
#  iw set US
  ;;

upgrade)
  echo "preinst upgrade"
#  systemctl stop rsyslog
  ;;

*)
  echo "Unrecognized preinst argument '$1'"

esac

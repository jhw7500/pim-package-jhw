#!/bin/bash

# Force locale to C.UTF-8
export LANG=C.UTF-8
export LC_ALL=C.UTF-8

############################################################
# postrm script main
############################################################
# Include debconf library.
. /usr/share/debconf/confmodule
db_get pim-mp/model
model=$RET

IIM_KERNEL_RELEASE=5.10.35-lts-5.10.y+g2fce14defc04
IIM_MODULE_ROOT=${IIM_MODULE_ROOT:-/lib/modules}
IIM_DEPMOD=${IIM_DEPMOD:-depmod}

# The systemd StateDirectory is operational history, not package-owned cache.
# Keep /var/lib/pim-camera across upgrade, remove, and purge.

refresh_iim42652_depmod() {
  if [ -d "$IIM_MODULE_ROOT/$IIM_KERNEL_RELEASE" ]; then
    if ! "$IIM_DEPMOD" -a "$IIM_KERNEL_RELEASE"; then
      echo "WARNING: depmod failed for IIM-42652 kernel $IIM_KERNEL_RELEASE; module dependency metadata may be stale" >&2
    fi
  fi
}

case "$1" in
purge)
  echo "purge purge"
  #rm -r /opt/pim
  rm -r /root/SOMBASE_TEST
  rm -r /root/shared_v
  cat /dev/null > /etc/rc.local
  systemctl disable cam-operate
  refresh_iim42652_depmod
  # gst-rtsp-server 교체본이 /usr/local/lib 에서 사라졌으니 캐시를 다시 만든다(순정 /usr/lib 본으로 돌아간다).
  ldconfig
  #systemctl set-default graphical.target
  ;;

upgrade)
  echo "purge upgrade ($model)"
  refresh_iim42652_depmod
  ;;

remove)
  echo "postrm remove ($model)"
  refresh_iim42652_depmod
  # gst-rtsp-server 교체본이 /usr/local/lib 에서 사라졌으니 캐시를 다시 만든다(순정 /usr/lib 본으로 돌아간다).
  ldconfig
  ;;

*)
  echo "Unrecognized postrm argument '$1'"

esac

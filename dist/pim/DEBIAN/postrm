#!/bin/bash

############################################################
# postrm script main
############################################################

case "$1" in
purge)
  echo "purge purge"
  rm -r /opt/pim
  cat /dev/null > /etc/rc.local
  sysetmctl set-default graphical.target
  ;;

upgrade)
  echo "purge upgrade"
  ;;

remove)
  echo "postrm remove"
  ;;

*)
  echo "Unrecognized postrm argument '$1'"

esac

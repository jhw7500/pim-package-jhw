#!/bin/bash

# Minimize locale warnings on minimal rootfs
if LC_ALL=C locale -a 2>/dev/null | grep -qi '^ko_KR\.utf8$'; then
  export LANG=ko_KR.UTF-8
  export LC_ALL=ko_KR.UTF-8
elif LC_ALL=C locale -a 2>/dev/null | grep -qi '^C\.utf8$'; then
  export LANG=C.UTF-8
  export LC_ALL=C.UTF-8
else
  export LANG=C
  export LC_ALL=C
fi

############################################################
# postrm script main
############################################################
# Include debconf library.
. /usr/share/debconf/confmodule
db_get pim-mp/model
model=$RET

case "$1" in
purge)
  echo "purge purge"
  #rm -r /opt/pim
  rm -r /root/SOMBASE_TEST
  rm -r /root/shared_v
  cat /dev/null > /etc/rc.local
  systemctl disable cam-operate
  #systemctl set-default graphical.target
  ;;

upgrade)
  echo "purge upgrade ($model)"
  ;;

remove)
  echo "postrm remove ($model)"
  ;;

*)
  echo "Unrecognized postrm argument '$1'"

esac

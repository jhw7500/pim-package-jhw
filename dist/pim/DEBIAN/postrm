#!/bin/bash

############################################################
# postrm script main
############################################################

case "$1" in
purge)
  echo "purge purge"
  #rm -r /opt/pim/bin/
  rm /etc/rc.local
  systemctl disable cam-operate
  #systemctl set-default graphical.target
  ;;

upgrade)
  echo "purge upgrade"
  ;;

remove)
  echo "postrm remove"
  ;;

*)
  echo "Unrecognized postrm argument '$1'"

esac

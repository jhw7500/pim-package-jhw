#!/bin/bash

############################################################
# postinst script main
############################################################

hostname=pim-camera-v016
tag=$(basename "$0")
KEY=PKG

case "$1" in
configure)
  echo "postinst configure"

  if [ ! -f  /etc/rsyslog.conf ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/rsyslog.conf"
    cp /opt/pim/etc/rsyslog.conf /etc/
  fi

  if [ ! -f  /etc/sysctl.conf ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/sysctl.conf"
    cp /opt/pim/etc/sysctl.conf /etc/
  fi

  if [ ! -f  /etc/modules ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/modules"
    cp /opt/pim/etc/modules /etc/
  fi

  if [ ! -f  /etc/crontab ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/crontab"
    cp /opt/pim/etc/crontab /etc/
  fi

  if [ ! -f  /etc/nanorc ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/nanorc"
    cp /opt/pim/etc/nanorc /etc/
  fi

  if [ ! -f  /etc/vsftpd.conf ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/vsftpd.conf"
    cp /opt/pim/etc/vsftpd.conf /etc/
  fi

  if [ ! -f  /etc/watchdog.conf ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/watchdog.conf"
    cp /opt/pim/etc/watchdog.conf /etc/
  fi

  if [ ! -f  /etc/cron.daily/logrotate ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/cron.daily/logrotate"
    cp /opt/pim/etc/cron.daily/logrotate /etc/cron.daily
  fi

  if [ ! -f  /etc/modprobe.d/blacklist.conf ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/modprobe.d/blacklist.conf"
    cp /opt/pim/etc/modprobe.d/blacklist.conf /etc/modprobe.d/
  fi

  if [ ! -f  /etc/systemd/journald.conf ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/systemd/journald.conf"
    cp /opt/pim/etc/systemd/journald.conf /etc/systemd/
  fi

  if [ ! -f  /etc/security/limits.conf ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/security/limits.conf"
    cp /opt/pim/etc/security/limits.conf /etc/security/
  fi


  systemctl restart rsyslog

  status=$(df |grep /dev/root |awk '{print $2}')
  if [ "$status" -ge 30000000 ]; then
    echo "disk size : $status over 30000000 byte"
  else
    echo "emmc auto size up"
    /opt/pim/bin/auto_fs_sizeup.sh 2 2
  fi


  status=$(timedatectl |grep NTP|awk '{print $3}')
  if [ "$status" == "inactive" ]; then
    echo "ntp is $status"
  else
    echo "set-ntp false"
    timedatectl set-ntp false
  fi

  status=$(timedatectl |grep Time|awk '{print $3}')
  if [ "$status" == "Asia/Seoul" ]; then
    echo "timezone is $status"
  else
    echo "set-timezone Asis/Seoul"
    timedatectl set-timezone Asia/Seoul
  fi

  #timedatectl set-timezone Etc/UTC

  status=$(systemctl get-default 2>/dev/null)
  #default_mode="graphical.target"
  default_mode="multi-user.target"
  if [ "$status" == "$default_mode" ]; then
    echo "defaultmode is $status"
  else
    echo "set-defualt $default_mode"
    systemctl set-default "$default_mode"
  fi

#  systemctl set-default multi-user.target

  daemon_name=imx8-isp
  status=$(systemctl is-enabled $daemon_name 2>/dev/null)
  if [ "$status" == "disabled" ]; then
    echo "$daemon_name is $status"
  else
    echo "disable imx8-isp"
    systemctl disable imx8-isp
  fi

#  systemctl restart cron

:<<'END'
  daemon_name=connman
  status=$(systemctl is-enabled $daemon_name 2>/dev/null)
  if [ "$status" == "disabled" ]; then
    echo "$daemon_name is $status"
  else
    echo "disable $daemon_name"
    systemctl disable $daemon_name
  fi
END

  daemon_name=connman-wait-online
  status=$(systemctl is-enabled $daemon_name 2>/dev/null)
  if [ "$status" == "disabled" ]; then
    echo "$daemon_name is $status"
  else
    echo "disable $daemon_name"
    systemctl disable $daemon_name
  fi


  daemon_name=NetworkManager
  status=$(systemctl is-enabled $daemon_name 2>/dev/null)
  if [ "$status" == "disabled" ]; then
    echo "$daemon_name is $status"
  else
    echo "disable network manager"
    systemctl disable NetworkManager
  fi

  daemon_name=systemd-network-wait-online
  status=$(systemctl is-enabled $daemon_name 2>/dev/null)
  if [ "$status" == "masked" ]; then
    echo "systemd-network-wait-online is mask"
  else
    echo "disable network-wait"
    systemctl disable systemd-networkd-wait-online.service
    echo "mask network-wait"
    systemctl mask systemd-networkd-wait-online.service
  fi

  daemon_name=nfs-client.target
  status=$(systemctl is-enabled $daemon_name 2>/dev/null)
  if [ "$status" == "disabled" ]; then
    echo "$daemon_name is $status"
  else
    echo "disable nfs"
    systemctl disable nfs-client.target
  fi

#  systemctl stop connman.service
#  systemctl disable connman.service

  daemon_name=docker
  status=$(systemctl is-enabled $daemon_name 2>/dev/null)
  if [ "$status" == "disabled" ]; then
    echo "$daemon_name is $status"
  else
    echo "disable docker"
    systemctl disable docker
  fi

  daemon_name=docker.socket
  status=$(systemctl is-enabled $daemon_name 2>/dev/null)
  if [ "$status" == "disabled" ]; then
    echo "$daemon_name is $status"
  else
    echo "disable docker.socket"
    systemctl disable docker.socket
  fi

  daemon_name=cam-operate
  status=$(systemctl is-enabled $daemon_name 2>/dev/null)
  if [ "$status" == "enabled" ]; then
    echo "$daemon_name is $status"
  else
    echo "disable docker.socket"
    systemctl enable cam-operate
  fi


  echo "check directory"
  if [ ! -d  /var/log/cantops ]; then
	mkdir /var/log/cantops
  fi

  if [ ! -d  /var/log/cantops/dot ]; then
    mkdir /var/log/cantops/dot
  fi

  if [ ! -d  /var/log/cantops/gst ]; then
    mkdir /var/log/cantops/gst
  fi

  if [ ! -d  /share ]; then
	mkdir /share
  fi

  if [ ! -d  /root/boot ]; then
    mkdir /root/boot
  fi

  if [ ! -d /mnt/sd_cam ]; then
    mkdir /mnt/sd_cam
  fi

  if [ -d /mnt/sd_cam/event ]; then
    rm -r /mnt/sd_cam/event
  fi

  if [ -d /mnt/sd_cam/recycle ]; then
    rm -r /mnt/sd_cam/recycle
  fi

  if [ -d /mnt/sd_cam/capture ]; then
    rm -r /mnt/sd_cam/capture
  fi

  echo "check edge config"
  if [ ! -f  /root/shared_v/edgeconf*.json ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp edgeconf_pim.json"
	cp /opt/pim/config/edgeconf_pim.json /root/shared_v/
  fi

  if [ ! -f  /opt/pim/config/edgeconf*default.json ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp edgeconf_pim_default.json"
    cp /opt/pim/config/edgeconf_pim.json /opt/pim/config/edgeconf_pim_default.json
  fi

  if [ ! -f  /etc/sysctl.conf ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/sysctl.conf"
    cp /opt/pim/etc/sysctl.conf /etc/
  fi

  if [ ! -f  /etc/modules ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/modules"
    cp /opt/pim/etc/modules /etc/
  fi

  if [ ! -f  /etc/crontab ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/crontab"
    cp /opt/pim/etc/crontab /etc/
  fi

  if [ ! -f  /etc/nanorc ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/nanorc"
    cp /opt/pim/etc/nanorc /etc/
  fi

  if [ ! -f  /etc/rsyslog.conf ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/rsyslog.conf"
    cp /opt/pim/etc/rsyslog.conf /etc/
  fi

  if [ ! -f  /etc/vsftpd.conf ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/vsftpd.conf"
    cp /opt/pim/etc/vsftpd.conf /etc/
  fi

  if [ ! -f  /etc/watchdog.conf ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/watchdog.conf"
    cp /opt/pim/etc/watchdog.conf /etc/
  fi

  if [ ! -f  /etc/cron.daily/logrotate ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/cron.daily/logrotate"
    cp /opt/pim/etc/cron.daily/logrotate /etc/cron.daily
  fi

  if [ ! -f  /etc/modprobe.d/blacklist.conf ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/modprobe.d/blacklist.conf"
    cp /opt/pim/etc/modprobe.d/blacklist.conf /etc/modprobe.d/
  fi

  if [ ! -f  /etc/systemd/journald.conf ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/systemd/journald.conf"
    cp /opt/pim/etc/systemd/journald.conf /etc/systemd/
  fi

  if [ ! -f  /etc/security/limits.conf ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp /etc/security/limits.conf"
    cp /opt/pim/etc/security/limits.conf /etc/security/
  fi

:<<'END'
  if [ ! -f  /etc/netplan/eth0.yaml ]; then
        logger -s -p local0.notice "[$KEY][$tag:$LINENO] apply default netplan eth0"
        cp /opt/pim/config/eth0.yaml /etc/netplan/
  fi

  if [ ! -f  /etc/netplan/eth1.yaml ]; then
        logger -s -p local0.notice "[$KEY][$tag:$LINENO] apply default netplan eth1"
        cp /opt/pim/config/eth1.yaml /etc/netplan/
  fi

  if [ ! -f /etc/netplan/wlp1s0.yaml ]; then 
        logger -s -p local0.notice "[$KEY][$tag:$LINENO] apply default netplan wlp1s0"
        cp /opt/pim/config/wlp1s0.yaml /etc/netplan/
  fi
END


  echo "update dtb"
  mount /dev/mmcblk2p1 /root/boot
  cp /opt/pim/boot/imx8mp*.dtb /root/boot/
  umount /root/boot

  echo "set id, passwd"
  (echo root; echo root;) | passwd root
  (echo user; echo user;) | smbpasswd -as user
  useradd -m semes && (echo semes; echo semes;) | passwd semes

#  chmod -R 777 /mnt/sd_cam
#  chmod 777 /share
  echo "set sshd"
  sed 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' -i /etc/ssh/sshd_config

  echo "set printk"
  sed '/kernel.printk/ c\kernel.printk = 2 4 1 3' -i /etc/sysctl.conf

#  echo "set hostname"
#  echo $hostname > /etc/hostname
#  sed -i "2s/.*/127.0.1.1 $hostname/g" -i /etc/hosts
#  sed -i 's/#kernel.printk = 3 4 1 3/kernel.printk = 2 4 1 3/g' -i /etc/sysctl.conf

  #/root/SOMBASE_TEST/mfg60n-aarch64-9.32.0.6.sh install
  #lmu -reg FCC
  #iw reg set US
  echo "update_network_pim.py"
  python /opt/pim/bin/update_network_pim.py
  udhcpc -i wlp1s0
  source /root/.bashrc
  source /root/.bash_aliases
  #netplan apply
  #systemctl restart connman
  #systemctl daemon-reload
  #dpkg -i /opt/pim/package/jq/*.deb
  #update_edgeconf &
  /opt/pim/bin/add_line.sh "root        soft    nofile      65536" /etc/security/limits.conf
  #/opt/pim/bin/add_line.sh "00 00   1 * *   root    logrotate /etc/logrotate.d/rsyslog" /etc/crontab
  #/opt/pim/bin/add_line.sh "00 00   * * *   root    /opt/pim/bin/chk_mmc.sh" /etc/crontab
  #/opt/pim/bin/add_line.sh "00  *   * * *   root    hwclock --systohc" /etc/crontab
  #/opt/pim/bin/add_line.sh "00  *   * * *   root    /opt/pim/bin/log_manage.sh /var/log/cantops 100" /etc/crontab
  #/opt/pim/bin/add_line.sh "write_enable=YES" /etc/vsftpd.conf
  #/opt/pim/bin/add_line.sh "local_umask=022" /etc/vsftpd.conf
  #/opt/pim/bin/comment_line.sh "$Umask 0022" /etc/rsyslog.conf
  /opt/pim/bin/change_line.sh "max9296" "max9296" /etc/modules
  /opt/pim/bin/change_line.sh "rts_ds1307" "rts_ds1307" /etc/modules
  /opt/pim/bin/change_line.sh "blacklist imx8-media-dev" "imx8-media-dev" /etc/modprobe.d/blacklist.conf
  /opt/pim/bin/change_line.sh "set tabsize 4" "set tabsize" /etc/nanorc
  /opt/pim/bin/change_line.sh "set tabstospaces" "set tabstospaces" /etc/nanorc
  /opt/pim/bin/change_line.sh "00 00   1 * *   root    logrotate /etc/logrotate.d/rsyslog" "logrotate /etc/logrotate.d/rsyslog" /etc/crontab
  /opt/pim/bin/change_line.sh "00 00   * * *   root    /opt/pim/bin/chk_mmc.sh" "/opt/pim/bin/chk_mmc.sh" /etc/crontab
  /opt/pim/bin/change_line.sh "00  *   * * *   root    hwclock --systohc" "hwclock --systohc" /etc/crontab
  /opt/pim/bin/change_line.sh "00  *   * * *   root    /opt/pim/bin/log_manage.sh /var/log/cantops 100" "/opt/pim/bin/log_manage.sh /var/log/cantops" /etc/crontab
  /opt/pim/bin/change_line.sh "write_enable=YES" "write_enable=" /etc/vsftpd.conf
  /opt/pim/bin/change_line.sh "local_umask=022" "local_umask=" /etc/vsftpd.conf
  /opt/pim/bin/change_line.sh "idle_session_timeout=0" "idle_session_timeout=" /etc/vsftpd.conf
  /opt/pim/bin/change_line.sh "chroot_local_user=YES" "chroot_local_user=" /etc/vsftpd.conf
  /opt/pim/bin/change_line.sh "local_root=/mnt/sd_cam" "local_root=" /etc/vsftpd.conf
  /opt/pim/bin/change_line.sh "allow_writeable_chroot=YES" "allow_writeable_chroot=" /etc/vsftpd.conf
  /opt/pim/bin/change_line.sh "#\$PrivDropToUser syslog" "\$PrivDropToUser" /etc/rsyslog.conf
  /opt/pim/bin/change_line.sh "#\$PrivDropToGroup syslog" "\$PrivDropToGroup" /etc/rsyslog.conf
  /opt/pim/bin/change_line.sh "watchdog-timeout = 30" "watchdog-timeout" /etc/watchdog.conf
  /opt/pim/bin/change_line.sh "watchdog-device = /dev/watchdog" "watchdog-device" /etc/watchdog.conf
  /opt/pim/bin/change_line.sh "kernel.printk = 2 4 1 3" "kernel.printk" /etc/sysctl.conf
  /opt/pim/bin/change_line.sh "SystemMaxUse=10000M" "SystemMaxUse=" /etc/systemd/journald.conf
  /opt/pim/bin/change_line.sh "SystemKeepFree=5000M" "SystemKeepFree=" /etc/systemd/journald.conf

  logger -p local0.notice "[$KEY][$tag:$LINENO] installation is finished"
  echo -e "\e[33mplease wait until deb package installation is finished\e[0m"
  #update_json 2 &
  /opt/pim/bin/install_deb.sh &
  #sync
  ;;

upgrade)
  echo "postinst upgrade"
  ;;

*)
  echo "Unrecognized postinst argument '$1'"

esac

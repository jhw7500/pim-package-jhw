############################################################
# postinst script main
############################################################
# Include debconf library.
. /usr/share/debconf/confmodule
db_get pim-mp/model
model=$RET

# init model info
/opt/cis/bin/init_model.sh "$model"

if [ ! -f /etc/cts/sysinfo.json ]; then
  # init default sysinfo
  /opt/cis/bin/init_sysinfo.sh "$model"
fi

#hostname=pim-camera-v016

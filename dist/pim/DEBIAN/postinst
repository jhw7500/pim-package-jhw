#!/bin/bash

############################################################
# postinst script main
############################################################

hostname=pim-camera-v016
tag=$(basename "$0")
KEY=PACKAGE

case "$1" in
configure)
  echo "postinst configure"
  systemctl restart rsyslog

  status=$(df |grep /dev/root |awk '{print $2}')
  if [ "$status" -ge 30000000 ]; then
    echo "disk size : $status over 30000000 byte"
  else
    echo "emmc auto size up"
    /opt/pim/bin/auto_fs_sizeup.sh 2 2
  fi


  status=$(timedatectl |grep NTP|awk '{print $3}')
  if [ "$status" == "inactive" ]; then
    echo "ntp is $status"
  else
    echo "set-ntp false"
    timedatectl set-ntp false
  fi

  status=$(timedatectl |grep Time|awk '{print $3}')
  if [ "$status" == "Asia/Seoul" ]; then
    echo "timezone is $status"
  else
    echo "set-timezone Asis/Seoul"
    timedatectl set-timezone Asia/Seoul
  fi

  #timedatectl set-timezone Etc/UTC

  status=$(systemctl get-default 2>/dev/null)
  if [ "$status" == "graphical.target" ]; then
    echo "defaultmode is $status"
  else
    echo "set-defualt graphical.target"
    systemctl set-default graphical.target
  fi

#  systemctl set-default multi-user.target

  daemon_name=imx8-isp
  status=$(systemctl is-enabled $daemon_name 2>/dev/null)
  if [ "$status" == "disabled" ]; then
    echo "$daemon_name is $status"
  else
    echo "disable imx8-isp"
    systemctl disable imx8-isp
  fi

#  systemctl restart cron

  daemon_name=NetworkManager
  status=$(systemctl is-enabled $daemon_name 2>/dev/null)
  if [ "$status" == "disabled" ]; then
    echo "$daemon_name is $status"
  else
    echo "disable network manager"
    systemctl disable NetworkManager
  fi

  daemon_name=systemd-network-wait-online
  status=$(systemctl is-enabled $daemon_name 2>/dev/null)
  if [ "$status" == "masked" ]; then
    echo "systemd-network-wait-online is mask"
  else
    echo "disable network-wait"
    systemctl disable systemd-networkd-wait-online.service
    echo "mask network-wait"
    systemctl mask systemd-networkd-wait-online.service
  fi

  daemon_name=nfs-client.target
  status=$(systemctl is-enabled $daemon_name 2>/dev/null)
  if [ "$status" == "disabled" ]; then
    echo "$daemon_name is $status"
  else
    echo "disable nfs"
    systemctl disable nfs-client.target
  fi

#  systemctl stop connman.service
#  systemctl disable connman.service

  daemon_name=docker
  status=$(systemctl is-enabled $daemon_name 2>/dev/null)
  if [ "$status" == "disabled" ]; then
    echo "$daemon_name is $status"
  else
    echo "disable docker"
    systemctl disable docker
  fi

  daemon_name=docker.socket
  status=$(systemctl is-enabled $daemon_name 2>/dev/null)
  if [ "$status" == "disabled" ]; then
    echo "$daemon_name is $status"
  else
    echo "disable docker.socket"
    systemctl disable docker.socket
  fi

  daemon_name=cam-operate
  status=$(systemctl is-enabled $daemon_name 2>/dev/null)
  if [ "$status" == "enabled" ]; then
    echo "$daemon_name is $status"
  else
    echo "disable docker.socket"
    systemctl enable cam-operate
  fi


  echo "check directory"
  if [ ! -d  /var/log/cantops ]; then
	mkdir /var/log/cantops
  fi

  if [ ! -d  /var/log/cantops/dot ]; then
    mkdir /var/log/cantops/dot
  fi

  if [ ! -d  /var/log/cantops/gst ]; then
    mkdir /var/log/cantops/gst
  fi

  if [ ! -d  /share ]; then
	mkdir /share
  fi

  if [ ! -d  /root/boot ]; then
    mkdir /root/boot
  fi

#  if [ ! -d /mnt/sd_cam ]; then
#    mkdir /mnt/sd_cam
#  fi

#  if [ -d /mnt/event ]; then
#    rm -r /mnt/event
#  fi

  echo "check edge config"
  if [ ! -f  /root/shared_v/edgeconf*.json ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp edgeconf_pim.json"
	cp /opt/pim/config/edgeconf_pim.json /root/shared_v/
  fi

  if [ ! -f  /opt/pim/config/edgeconf*default.json ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp edgeconf_pim_default.json"
    cp /opt/pim/config/edgeconf_pim.json /opt/pim/config/edgeconf_pim_default.json
  fi

:<<'END'
  if [ ! -f  /etc/netplan/eth0.yaml ]; then
        logger -s -p local0.notice "[$KEY][$tag:$LINENO] apply default netplan eth0"
        cp /opt/pim/config/eth0.yaml /etc/netplan/
  fi

  if [ ! -f  /etc/netplan/eth1.yaml ]; then
        logger -s -p local0.notice "[$KEY][$tag:$LINENO] apply default netplan eth1"
        cp /opt/pim/config/eth1.yaml /etc/netplan/
  fi

  if [ ! -f /etc/netplan/wlp1s0.yaml ]; then 
        logger -s -p local0.notice "[$KEY][$tag:$LINENO] apply default netplan wlp1s0"
        cp /opt/pim/config/wlp1s0.yaml /etc/netplan/
  fi
END


  echo "update dtb"
  mount /dev/mmcblk2p1 /root/boot
  cp /opt/pim/boot/imx8mp*.dtb /root/boot/
  umount /root/boot

  echo "set id, passwd"
  (echo root; echo root;) | passwd root
  (echo user; echo user;) | smbpasswd -as user
  useradd -m semes && (echo semes; echo semes;) | passwd semes

#  chmod -R 777 /mnt/sd_cam
#  chmod 777 /share
  echo "set sshd"
  sed 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' -i /etc/ssh/sshd_config

  echo "set hostname"
#  sed 's/imx8mpevk/$hostname/' -i /etc/hostname
  echo $hostname > /etc/hostname
  #sed 's/127.0.0.1/"127.0.0.1 "$hostname/g' -i /etc/hosts
  sed -i "2s/.*/127.0.1.1 $hostname/g" -i /etc/hosts
#  sed -i 's/#kernel.printk = 3 4 1 3/kernel.printk = 2 4 1 3/g' -i /etc/sysctl.conf

  #/root/SOMBASE_TEST/mfg60n-aarch64-9.32.0.6.sh install
  #lmu -reg FCC
  #iw reg set US
  echo "update_network_pim.py"
  python /opt/pim/bin/update_network_pim.py
  source /root/.bashrc
  source /root/.bash_aliases
  #netplan apply
  #systemctl restart connman
#  systemctl daemon-reload

  logger -p local0.notice "[$KEY][$tag:$LINENO] install pim.deb"
  sync
  ;;

upgrade)
  echo "postinst upgrade"
  ;;

*)
  echo "Unrecognized postinst argument '$1'"

esac

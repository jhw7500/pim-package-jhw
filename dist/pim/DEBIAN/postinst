KEY=PKG
PACKAGE_NAME="$DPKG_MAINTSCRIPT_PACKAGE"
KERNEL_VERSION=$(uname -r)
hostname=$(python3 /opt/cis/bin/getconfval.py hostname)

case "$1" in
configure)
  echo "postinst configure ($model)"

cpchk() {
  if [ ! -f $2 ]; then
    logger -s -p local0.notice "[$KEY][$tag:$LINENO] cp $1 $2"
    cp $1 $2
  fi
}
  cp /opt/pim/etc/rsyslog.d/50-default.conf /etc/rsyslog.d/
  cpchk /opt/pim/etc/rsyslog.conf /etc/rsyslog.conf

  systemctl restart rsyslog

  cpchk /opt/pim/etc/sysctl.conf /etc/sysctl.conf
  cpchk /opt/pim/etc/modules /etc/modules

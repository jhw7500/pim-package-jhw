        #/opt/pim/bin/comment_line.sh "/opt/pim/bin/led_ctrl.sh 2>/dev/null" /opt/pim/bin/BG_Check_for_pim.sh
    else
        echo "sea_app is not installed"
        /opt/pim/bin/change_line.sh "    /opt/pim/bin/led_ctrl.sh 2>/dev/null" "/opt/pim/bin/led_ctrl.sh" /opt/pim/bin/BG_Check_for_pim.sh
    fi


  update_edgeconf

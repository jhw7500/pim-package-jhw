/var/log/cantops/kern.log
/var/log/cantops/local0.log
/var/log/cantops/local1.log
/var/log/cantops/syslog
{
	rotate 24
	weekly
	missingok
	notifempty
	delaycompress
	compress
    dateext
	postrotate
		/usr/lib/rsyslog/rsyslog-rotate
	endscript
}

/var/log/mail.info
/var/log/mail.warn
/var/log/mail.err
/var/log/mail.log
/var/log/kern.log
/var/log/daemon.log
/var/log/auth.log
/var/log/user.log
/var/log/lpr.log
/var/log/cron.log
/var/log/debug
/var/log/messages
{
	rotate 6
	monthly
	missingok
	notifempty
	delaycompress
    compress
    dateext
	sharedscripts
	postrotate
		/usr/lib/rsyslog/rsyslog-rotate
	endscript
}

#!/usr/bin/env bash
set -u

if [ -z "${PIM_LIB:-}" ]; then
    SCRIPT_PATH=$(readlink -f "${BASH_SOURCE[0]}") || exit 70
    PIM_LIB=$(cd "$(dirname "$SCRIPT_PATH")/../lib" && pwd) || exit 70
fi
source "$PIM_LIB/cam_recovery.sh"

# ACTION 을 적지 않으면 호출자가 _cr_public_action 을 읽어야 알 수 있었고, 에스컬레이션은
# 어디에도 안 적혀 있었다 — module_reload 를 요청한 사람이 실패가 이어지면 재부팅을 받는다.
# 목록의 출처는 _cr_public_action 하나다(cam_recovery.sh). 거기에 action 을 더하면 여기도 더한다.
usage() { cat >&2 <<'USAGE'
usage: cam-recoveryctl request ACTION --source NAME --reason TEXT [--wait SEC]
     | apply-config --source NAME --reason TEXT [--wait SEC]
     | status [--request-id UUID] [--json]

ACTION 과 실패 시 에스컬레이션:
  gstapp_restart     gstApp 만 재시작. 커널을 건드리지 않고 에스컬레이션도 없다
  module_reload      소비자 정지 후 모듈 재적재. 실패하면 camera_hard_reset -> reboot_fallback
  camera_hard_reset  모듈 내리고 CSI/ISI 를 unbind/bind 한 뒤 재적재. 실패하면 reboot_fallback
  reboot_fallback    보드 재부팅. 위 두 단의 최종 폴백이고 직접 요청도 받는다
  gstapp_stop        gstApp 정지만. 체인에 자리가 없고 executor 진입점이 거부한다

apply_config 는 request 가 아니라 apply-config 서브커맨드로 보낸다.
USAGE
}
bad() { usage; exit 64; }
wait_for_result() {
    local id=$1 type=$2 seconds=$3 started now result status rc
    [[ $seconds =~ ^[0-9]+$ ]] || return 64
    # The request is already queued here; the loop below can hold the terminal for
    # most of a minute on a loaded board, and until now it printed nothing, which
    # reads as a hang (issue #109 was reported as "almost like it froze").  This
    # goes to stderr on purpose: the stdout contract is the single
    # CAM_RECOVERY_RESULT line, and recovery_protocol_test.sh compares that
    # capture by exact string while redirecting stdout only.
    printf 'CAM_RECOVERY_SUBMITTED id=%s type=%s (waiting up to %ss)\n' "$id" "$type" "$seconds" >&2
    started=$(date +%s)
    while :; do
        result=$(cam_recovery_status_json "$id" 2>/dev/null); result_rc=$?
        [ "$result_rc" -eq 0 ] && {
            status=$(jq -r .status <<<"$result"); rc=$(jq -r .rc <<<"$result")
            echo "CAM_RECOVERY_RESULT id=$id type=$type status=$status rc=$rc"
            [ "$status" = SUCCEEDED ] && return 0 || return "$rc"
        }
        [ "$result_rc" -eq 69 ] || return "$result_rc"
        now=$(date +%s)
        [ $((now - started)) -ge "$seconds" ] && return 124
        sleep 0.1
    done
}
request() {
    local type=$1; shift; local source= reason= wait=
    while [ $# -gt 0 ]; do case "$1" in --source) [ $# -ge 2 ] || bad; source=$2; shift 2;; --reason) [ $# -ge 2 ] || bad; reason=$2; shift 2;; --wait) [ $# -ge 2 ] || bad; wait=$2; shift 2;; *) bad;; esac; done
    _cr_request_type "$type" || bad
    [ -n "$source" ] && [ -n "$reason" ] || bad
    [ -z "$wait" ] || [[ $wait =~ ^[0-9]+$ ]] || bad
    local id rc
    id=$(cam_request_submit "$type" "$source" "$reason"); rc=$?
    [ "$rc" -eq 0 ] || return "$rc"
    if [ -n "$wait" ]; then wait_for_result "$id" "$type" "$wait"; else printf '%s\n' "$id"; fi
}
case "${1:-}" in
    request) [ $# -ge 2 ] || bad; type=$2; shift 2; [ "$type" != apply_config ] || bad; request "$type" "$@"; exit $?;;
    apply-config) shift; request apply_config "$@"; exit $?;;
    status)
        shift; id=; json=0
        while [ $# -gt 0 ]; do case "$1" in --request-id) [ $# -ge 2 ] || bad; id=$2; shift 2;; --json) json=1; shift;; *) bad;; esac; done
        [ -z "$id" ] || [[ $id =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || bad
        cam_recovery_status_json "$id"; exit $?;;
    *) bad;;
esac

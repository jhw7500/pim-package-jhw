#!/bin/bash

tag=$(basename "$0")

show_help() {
    echo "Usage: $tag [options]"
    echo "Options:"
    echo "arg1 : i2c line number"
    echo "arg2 : device address(hex)"
    echo "arg3 : register address(hex)"
    echo "arg4 : data(hex)"
}

if [[ "$1" == "--help" || "$1" == "-h" || -z "$1" ]]; then
    show_help
    exit 0
fi

ad0=$(($3>>8&0xff))
ad1=$(($3&0xff))
ad0=$(printf "0x%02x\n" $ad0)
ad1=$(printf "0x%02x\n" $ad1)

val0=$(($4>>8&0xff))
val1=$(($4&0xff))
val0=$(printf "0x%02x\n" $val0)
val1=$(printf "0x%02x\n" $val1)
#echo "$val0 $val1"
if [[ $val0 == 0x00 ]]; then
    echo "i2ctransfer -f -y -a $1 w3@$2 $ad0 $ad1 $val1"
    i2ctransfer -f -y -a $1 w3@$2 $ad0 $ad1 $val1
else
    echo "i2ctransfer -f -y -a $1 w3@$2 $ad0 $ad1 $val0 $val1"
    i2ctransfer -f -y -a $1 w4@$2 $ad0 $ad1 $val0 $val1
fi

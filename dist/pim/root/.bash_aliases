alias lmt='ls -ltr /mnt |tail -n $1'
alias let='ls -ltr /mnt/event |tail -n $1'
alias dpkgp='dpkg -i --force-overwrite pim.deb'
alias slogg='cat /var/log/syslog | grep $1'
alias slogt='cat /var/log/syslog | tail -n $1'
alias clogg='cat /var/log/cantops/$(date "+%Y%m%d").log | grep $1'
alias clogt='cat /var/log/cantops/$(date "+%Y%m%d").log |tail -n $1'
alias klogg='cat /var/log/kern.log | grep $1'
alias klogt='cat /var/log/kern.log | tail -n $1'
alias psg='ps -ef |grep $1'

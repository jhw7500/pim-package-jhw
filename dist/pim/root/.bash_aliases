
alias lmt='ls -l /mnt |tail -n $1'
alias lmtt='ls -ltr /mnt |tail -n $1'
alias lmh='ls -l /mnt |head -n $1'
alias lmth='ls -ltr /mnt |head -n $1'
alias let='ls -l /mnt/event |tail -n $1'
alias lett='ls -ltr /mnt/event |tail -n $1'
alias leh='ls -l /mnt/event |head -n $1'
alias leth='ls -ltr /mnt/event |head -n $1'
alias lstf='ls -l --time-style full-iso $1'
alias dpkgif='dpkg -i --force-overwrite $1'
alias dpkglg='dpkg -l |grep $1'
alias tslogf='tail -f /var/log/syslog'
alias slogg='cat /var/log/syslog | grep $1 -a'
alias slogt='cat /var/log/syslog | tail -n $1'
alias slogh='cat /var/log/syslog | head -n $1'
alias clogg='cat /var/log/cantops/$(date "+%Y%m%d").log | grep $1 -a'
alias clogt='cat /var/log/cantops/$(date "+%Y%m%d").log |tail -n $1'
alias clogh='cat /var/log/cantops/$(date "+%Y%m%d").log |head -n $1'
alias llogg='cat /var/log/cantops/local0.log | grep $1 -a'
alias llogt='cat /var/log/cantops/local0.log | tail -n $1'
alias llogh='cat /var/log/cantops/local0.log | head -n $1'
#alias klogg='cat /var/log/kern.log | grep $1 -a'
#alias klogt='cat /var/log/kern.log | tail -n $1'
#alias klogh='cat /var/log/kern.log | head -n $1'
alias klogg='cat /var/log/cantops/kern.log | grep $1 -a'
alias klogt='cat /var/log/cantops/kern.log | tail -n $1'
alias klogh='cat /var/log/cantops/kern.log | head -n $1'
alias psg='ps -ef |grep $1'
alias sst='systemctl status $1'
alias sss='systemctl start $1'
alias ssp='systemctl stop $1'
alias ssr='systemctl restart $1'
alias sse='systemctl eanble $1'
alias ssd='systemctl disable $1'
alias ssg='systemctl |grep $1'
alias camchk1='i2ctransfer -f -y 1 w2@0x48 0x00 0x13 r1'
alias camchk2='i2ctransfer -f -y 2 w2@0x48 0x00 0x13 r1'
alias jo='journalctl -o short-iso-precise'

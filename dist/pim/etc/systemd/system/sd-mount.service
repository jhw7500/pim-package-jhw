[Unit]
Description=PIM SD Mount Service
DefaultDependencies=no
Before=sysinit.target

[Service]
User=root
WorkingDirectory=/root
#ExecStartPre=/bin/sleep 1
ExecStart=/opt/pim/bin/automnt_sd_for_emmc_boot.sh
ExecStop=/opt/pim/bin/sd_mount_stop.sh
Restart=on-failure
RestartSec=5s
#ExecStop=systemctl stop cam-operate
#ExecStop=umount /dev/mmcblk1p1
[Install]
WantedBy=multi-user.target

[Unit]
Description=PIM CAM Operation Service
#After=syslog.service
#After=rc-local.service
After=sd-mount.service
DefaultDependencies=no
#Before=sysinit.target

[Service]
User=root
WorkingDirectory=/root
ExecStart=/opt/pim/bin/chk_cam_operate.sh
#ExecStartPost=/bin/sh -c 'sleep 3 && systemctl restart ord-operate.service'
#ExecStartPost=systemctl start ord-operate.service
ExecStop=/opt/pim/bin/cam_operate_stop.sh
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target

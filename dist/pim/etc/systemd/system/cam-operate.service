[Unit]
Description=PIM CAM Operation Service
Requires=pim-camera-config.service
After=pim-camera-config.service sd-mount.service

[Service]
User=root
WorkingDirectory=/root
ExecStart=/opt/pim/bin/chk_cam_operate.sh
ExecStartPost=/bin/sh -c 'until test -f /run/pim-camera/config/pim_runtime.json && /opt/pim/bin/camera_runtime_config.py validate --file /run/pim-camera/config/pim_runtime.json; do sleep 1; done'
ExecStop=-/bin/kill -TERM $MAINPID
ExecStop=/usr/bin/timeout --signal=TERM --kill-after=5s 120s /opt/pim/bin/cam_operate_stop.sh --systemd
RuntimeDirectory=pim-camera
RuntimeDirectoryMode=0750
StateDirectory=pim-camera
StateDirectoryMode=0750
# 이슈 #141: _cra_fail 이 남기는 단계 이름을 journald 회전 뒤에도 조사할 수 있게
# 디스크로도 보낸다. StateDirectory 아래라 재부팅을 횡단한다. 상한은
# PIM_CAMERA_ACTION_LOG_MAX_BYTES (기본 256KiB) 이고 _cra_log_persist 가 절삭한다.
Environment=PIM_CAMERA_ACTION_LOG=/var/lib/pim-camera/recovery/actions.log
KillMode=control-group
SuccessExitStatus=143
TimeoutStartSec=90s
TimeoutStopSec=130s
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target

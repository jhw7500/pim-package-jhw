[Unit]
Description=PIM Camera Configuration Prerequisite Guard
Requires=pim-config-guard.service
After=pim-config-guard.service
Before=cam-operate.service
RequiresMountsFor=/root/shared_v

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/pim/bin/camera_config_bootstrap.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

+void BufferBase::IncreaseQueueSize() {
+    size_t new_size = q_count_ * 2;  // 큐 크기를 두 배로 증가
+    if (new_size > MAX_QUEUE_SIZE) {
+        new_size = MAX_QUEUE_SIZE;  // 최대 큐 크기를 초과하지 않도록 제한
+    }
+
+    uint8_t* new_buf = (uint8_t*)malloc(new_size * buf_size_);
+    if (!new_buf) {
+        std::cout << "Memory allocation failed during queue resizing." << std::endl;
+        return;
+    }
+
+    // 기존 데이터를 새 버퍼로 복사
+    for (size_t i = 0; i < q_count_; ++i) {
+        memcpy(new_buf + i * buf_size_, q_buf_ + ((q_head_ + i) % q_count_) * buf_size_, buf_size_);
+    }
+
+    free(q_buf_);  // 기존 버퍼 해제
+    q_buf_ = new_buf;
+    q_count_ = new_size;
+    q_head_ = 0;
+    q_tail_ = q_count_ / 2;
+}

+#else
+
+bool BufferBase::Push(const void *ptr) {
+    size_t new_tail;
+    q_mutex_.lock();
+    new_tail = (q_tail_ + 1) % q_count_;
+
+    // 큐가 가득 차면 크기를 증가시킴
+    if (new_tail == q_head_) {
+        std::string cal_msg;
+        char buffer[256];
+
+        if (q_count_ >= MAX_QUEUE_SIZE) {
+            // 큐의 크기가 최대치를 넘으면 false를 반환
+            q_mutex_.unlock();
+            //std::cout << "Queue size limit reached. Unable to increase size." << std::endl;
+            sprintf(buffer, "q_tail:%ld, new_tail:%ld, q_head:%ld, q_count:%ld, q_max:%lld", q_tail_, new_tail, q_head_, q_count_, MAX_QUEUE_SIZE);
+            cal_msg = "ADAB|queue full, ";
+            cal_msg += buffer;
+            log_.LogWrite(LOG_ERR, cal_msg);
+            return false;
+        }
+
+        IncreaseQueueSize();  // 큐 크기를 증가시키는 함수
+        //std::cout << "push new_tail : "<< new_tail << ", q_head :"<< q_head_ << ", q_count : "<< q_count_ <<std::endl;
+        sprintf(buffer, "q_tail:%ld, new_tail:%ld, q_head:%ld, q_count:%ld, q_max:%lld", q_tail_, new_tail, q_head_, q_count_, MAX_QUEUE_SIZE);
+        cal_msg = "ADAB|queue increase size, ";
+        cal_msg += buffer;
+        log_.LogWrite(LOG_WARNING, cal_msg);
+    }
+
+    // 데이터 복사
+    memcpy(q_buf_ + q_tail_ * buf_size_, ptr, buf_size_);
+
+    // tail 포인터 업데이트
+    q_tail_ = new_tail;
+    q_mutex_.unlock();
+    cv_.notify_one();
+
+    return true;
+}
+
+bool BufferBase::Pop(void *ptr, uint64_t *timestamp) {
+    std::unique_lock<std::mutex> lk(cv_m_);
+    if (q_head_ == q_tail_) {
+        // 대기 시간 설정
+        auto now = std::chrono::system_clock::now();
+        if (!cv_.wait_until(lk, now + std::chrono::milliseconds(10), [this] { return q_head_ != q_tail_; })) {
+            return false;
+        }
+
+        if (*timestamp == 0) {
+            struct timeval time;
+            gettimeofday(&time, NULL);
+            *timestamp = (uint64_t)time.tv_sec * 1000000 + (uint64_t)time.tv_usec;
+        }
+    }
+
+    // 큐에서 데이터 복사
+    q_mutex_.lock();
+    memcpy(ptr, q_buf_ + q_head_ * buf_size_, buf_size_);
+    q_head_ = (q_head_ + 1) % q_count_;
+    q_mutex_.unlock();
+    //std::cout << "pop q_head : "<< q_head_ << std::endl;
+    
+    return true;
+}
+#endif
